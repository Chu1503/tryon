# Application storage and database
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/wardrobe.db
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=25

# Garment processing
REMBG_MODEL=birefnet-general-lite
NORMALIZED_CANVAS_SIZE=1024
ENABLE_WRINKLE_CLEANING=false

# Virtual try-on
# Set true only for UI development without real CatVTON inference.
MOCK_VTON=false
VTON_PROVIDER=hybrid
# Optional but recommended: a free Hugging Face read token raises ZeroGPU quota.
HF_TOKEN=
FASHN_SPACE=fashn-ai/fashn-vton-1.5
FASHN_STEPS=30
FASHN_GUIDANCE_SCALE=1.5
CATVTON_REPO_PATH=./models/CatVTON
CATVTON_BASE_MODEL=runwayml/stable-diffusion-inpainting
CATVTON_CHECKPOINT=zhengchong/CatVTON
CATVTON_PRECISION=fp16
CATVTON_STEPS=12
CATVTON_GUIDANCE_SCALE=2.5
CATVTON_WIDTH=384
CATVTON_HEIGHT=512
CATVTON_SKIP_SAFETY_CHECK=true
CATVTON_ALLOW_CPU=false
GENERATION_WORKERS=1
